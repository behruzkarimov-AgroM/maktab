# ======================================================================
# Children's Academy environment. Copy to .env.local. Validated by lib/env.ts.
# Leave the Supabase block EMPTY to run in DEMO mode (seed data + localStorage).
# ======================================================================

# --- Self-hosted PostgreSQL, no Supabase (docs/SELF-HOSTED.md) ------------
# When DATABASE_URL is set the app uses this database directly (own login system); leave the Supabase block below empty.
DATABASE_URL=
# Signs the session cookies (32+ characters): openssl rand -hex 32
AUTH_SECRET=
# Uploaded files (served under /media/...); keep it outside the project folder so rebuilds never touch it
UPLOAD_DIR=

# --- Supabase (set URL and anon key TOGETHER) --------------------------
# Project Settings -> API -> Project URL / anon public key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings -> API -> service_role key. SERVER ONLY, never expose or commit.
# Enables: DB-backed rate limiting, admin CMS writes/uploads, olympiad leaderboard, audit log.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site --------------------------------------------------------------
# Public canonical URL, no trailing slash (used for absolute links / QR / metadata).
NEXT_PUBLIC_SITE_URL=

# --- Demo accounts -----------------------------------------------------
# The demo accounts (admin@demo.uz, director@demo.uz, ...) are CLOSED unless this is "true" AND Supabase is not configured
# (never on Vercel). Only for tests / local demos. Leave unset for real use.
ALLOW_ADMIN_DEMO=

# --- Accounts ----------------------------------------------------------
# Domain of the generated logins (initial accounts and /admin/enroll), e.g. karimov.sardor@childrensacademy.uz.
# Initial accounts, one per role: npm run accounts:create  ->  HISOBLAR.local.md (git-ignored)
SCHOOL_EMAIL_DOMAIN=

# --- School portal (/school) -------------------------------------------
# Demo mode (no Supabase) uses the same ALLOW_ADMIN_DEMO rule as the admin. Telegram message to a guardian's own chat id
# when a student is marked absent (needs TELEGRAM_BOT_TOKEN). Off unless "on".
SCHOOL_NOTIFY_ABSENCE=

# Password reset e-mails (/api/school/auth/request-reset) redirect to NEXT_PUBLIC_SITE_URL + /school/reset-password; add that URL to
# Supabase -> Authentication -> URL Configuration -> Redirect URLs and configure custom SMTP (docs/SUPABASE-GO-LIVE.md).
# `npm run smoke` extra variables: BASE_URL, SMOKE_ADMIN_EMAIL/PASSWORD, SMOKE_SCHOOL_<DIRECTOR|TEACHER|PARENT|STUDENT>_EMAIL/PASSWORD.

# --- Telegram notifications for admission applications (set both) ------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Telegram bot (separate project maktab2.0-telegram-bot, docs/TELEGRAM-BOT.md) ---
# Shared secret (32+ chars), IDENTICAL in the bot's .env. Unset = the bot API is off.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_API_SECRET=
# The bot's @username without "@" (for the portal's "Connect Telegram" link). TELEGRAM_BOT_TOKEN above must be the same bot.
TELEGRAM_BOT_USERNAME=

# --- SMS (reserved for ticket / result notifications; not wired yet) ----
SMS_PROVIDER=
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER=

# --- Document import (admin: Word/PDF/Excel/image -> quiz, test, survey, game content) ---
# OCR for images and scanned PDFs (tesseract.js, runs on the server, offline). Heavy: default ON locally, OFF on Vercel
# unless set to "on". See docs/IMPORT.md.
IMPORT_OCR=
# Optional AI structuring ("Analyze with AI" toggle in the import dialog). Only the EXTRACTED TEXT is sent to the Anthropic
# Messages API. Leave empty to hide the toggle.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
